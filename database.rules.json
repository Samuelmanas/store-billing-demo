{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "settings": {
      "store": {
        ".validate": "newData.hasChildren(['name', 'address', 'phone', 'receiptWidth'])"
      }
    },
    "products": {
      "$productId": {
        ".validate": "newData.hasChildren(['name', 'nameLower', 'quantity', 'updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
        },
        "nameLower": {
          ".validate": "newData.isString() && newData.val() == newData.parent().child('name').val().toLowerCase()"
        },
        "purchasePrice": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "quantity": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "stockUnit": {
          ".validate": "newData.val() == 'packet' || newData.val() == 'weight'"
        },
        "weightGrams": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "packetQuantity": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "weightedAvgPurchasePrice": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "bills": {
      "$billId": {
        ".validate": "newData.hasChildren(['billNumber', 'createdAt', 'items', 'subtotal', 'discount', 'discountType', 'discountValue', 'total'])",
        "billNumber": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "subtotal": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "discount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "discountType": {
          ".validate": "newData.val() == 'amount' || newData.val() == 'percent'"
        },
        "discountValue": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "items": {
          ".validate": "newData.hasChildren()"
        }
      }
    }
  }
}